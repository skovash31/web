rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == u;
    }
    match /groups/{g} {
      allow create: if request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth.uid in resource.data.members;
      match /messages/{m} {
        allow read: if request.auth.uid in get(/databases/$(db)/documents/groups/$(g)).data.members;
        allow create: if request.auth.uid in get(/databases/$(db)/documents/groups/$(g)).data.members
                      && request.resource.data.uid == request.auth.uid;
      }
    }
    match /friendships/{f} {
      allow create: if request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth.uid in resource.data.members;
      match /messages/{m} {
        allow read: if request.auth.uid in get(/databases/$(db)/documents/friendships/$(f)).data.members;
        allow create: if request.auth.uid in get(/databases/$(db)/documents/friendships/$(f)).data.members
                      && request.resource.data.uid == request.auth.uid;
      }
    }
  }
}
